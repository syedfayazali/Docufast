# Set these in Vercel → Settings → Environment Variables
# Never commit the real .env file (it's in .gitignore)

RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...          # NEVER expose to frontend
RAZORPAY_WEBHOOK_SECRET=...      # Set in Razorpay Dashboard -> Settings -> Webhooks
                                  # (different from KEY_SECRET above — see pages/api/webhooks/razorpay.js)

AGENT_KEY=...                    # Random secret shared with the local print agent

OWNER_KEY=...                    # Your FIRST owner password. Sign in at /owner.html with it,
                                  # then use "Change password" to set your own (stored hashed in
                                  # the database). OWNER_KEY still works as an emergency way in;
                                  # delete it in Vercel once you have your own password, and add
                                  # it back if you ever forget that password.
SESSION_SECRET=...               # Optional. Random text, 16+ characters, used to sign the owner
                                  # login cookie. If unset it is derived from OWNER_KEY. Set this
                                  # if you delete OWNER_KEY. Changing it signs the owner out.

CRON_SECRET=...                  # Any random string — protects /api/cron/cleanup.
                                  # Vercel sends this automatically as a Bearer
                                  # token when it triggers the scheduled cron
                                  # (see vercel.json), once this is set.

# Injected automatically by Vercel when you connect storage:
# DATABASE_URL=...               (from Neon/Supabase in Storage tab)
# BLOB_READ_WRITE_TOKEN=...      (from Blob in Storage tab)
