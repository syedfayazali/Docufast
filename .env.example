# Set these in Vercel → Settings → Environment Variables
# Never commit the real .env file (it's in .gitignore)

RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...          # NEVER expose to frontend

AGENT_KEY=...                    # Random secret shared with the local print agent

# Injected automatically by Vercel when you connect storage:
# DATABASE_URL=...               (from Neon/Supabase in Storage tab)
# BLOB_READ_WRITE_TOKEN=...      (from Blob in Storage tab)
