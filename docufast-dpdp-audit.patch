+// ---- Customer-requested deletion (DPDP) ----
+export function newDeleteToken() {
+  const token = randomBytes(24).toString('base64url');
+  return { token, hash: hashDeleteToken(token) };
+}
+function hashDeleteToken(token) {
+  return createHash('sha256').update(String(token)).digest('hex');
+}
+// Proof the caller is the customer: the secret token given at order time, or
+// the full Razorpay payment id (which only the payer receives).
+export function canDeleteJob(job, { token, paymentId }) {
+  if (token && job.delete_token_hash && safeEqual(hashDeleteToken(token), job.delete_token_hash)) return true;
+  if (paymentId && job.razorpay_payment_id && safeEqual(String(paymentId).trim(), job.razorpay_payment_id)) return true;
+  return false;
+}
+// Statuses where deleting the file cannot strand a paid, unprinted order.
+export const CUSTOMER_DELETABLE = ['pending_payment', 'printed', 'refunded', 'expired'];
+export async function markJobDeleted(code) {
+  await ensureSchema();
+  await query(
+    `UPDATE jobs SET blob_url=NULL, deleted_at=now(),
+       status = CASE WHEN status='pending_payment' THEN 'expired' ELSE status END
+     WHERE code=$1`, [code]);
+  await logStatus(code, 'file_deleted', 'customer', 'deleted at customer request');
+}
